BESU_PRIVATE_KEY=
BESU_AM_CONTRACT_OWNER_PRIVATE_KEY=
BESU_RPC_URL=

# Deployed contract addresses (fill in after running each deployment script)
DEPLOYED_ASSETV1_CONTRACT=              # AssetV1 contract address
DEPLOYED_AM_CONTRACT=                   # AMContract contract address
DEPLOYED_RESEARCHER_POLICY_CONTRACT=    # ResearcherPolicy contract address

# Script parameters (set before running admin scripts)
SUBJECT=                   # Ethereum address of the subject (for setAttribute, evaluatePolicy)
ATTR_KEY=                  # Attribute key (for setAttribute, e.g. "role")
ATTR_VALUE=                # Attribute value (for setAttribute, e.g. "researcher")
ASSET_ID=                  # Asset ID (for setPolicyAddress)